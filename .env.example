BOT_TOKEN=123456:ABC...
# канал статистики: @username или id (через запятую, если несколько)
RESULT_SOURCES=@statistika_baccara
# id админов (узнать свой: /id): панель /admin, /give, список победителей в личку
ADMINS=
DB_PATH=suitbot.sqlite3

# Сколько фишек за 1 звезду и какие пакеты продавать (в звёздах)
CHIPS_PER_STAR=100
STAR_PACKS=1,5,10,50
# Контакт для /paysupport
SUPPORT_CONTACT=@Dogfreez
START_BALANCE=500
# Бонус: сколько фишек и раз в сколько дней
BONUS_AMOUNT=300
BONUS_PERIOD_DAYS=7
MIN_BET=10
MAX_BET=10000

MAX_GAMES_AHEAD=20
GAME_NUMBER_WRAP=1440
BET_TTL_HOURS=6
# Если канал публикует пост игры только ПОСЛЕ её окончания (без ⏰ в начале),
# поставьте здесь длительность игры в секундах: ставки на следующую игру
# закроются через это время после поста предыдущей. 0 — выключено.
BET_WINDOW_SECONDS=0

# Обязательная подписка на канал (бот должен быть админом канала)
REQUIRED_CHANNEL=@statistika_baccara
REQUIRED_CHANNEL_URL=https://t.me/statistika_baccara

PAYOUT_SUIT=1.9
PAYOUT_PLAYER=1.95
PAYOUT_BANKER=1.95
PAYOUT_TIE=8

# Карточки игр с кнопками: каждая N-я игра (1 — каждая, 0 — выкл). Меняется в /admin.
CARD_EVERY=1

# Турнир: запускается из /admin на 1, 3 или 7 дней
TOURNAMENT_ENABLED=1
# 1 — дополнительно запускать автоматически каждый понедельник
TOURNAMENT_AUTO=0
TOURNAMENT_TZ=Europe/Moscow
TOURNAMENT_START_CHIPS=1000
TOURNAMENT_MAX_BET=500
TOURNAMENT_MIN_BETS=20
TOURNAMENT_MIN_DAYS_IN_BOT=0
# Призы по местам через |
TOURNAMENT_PRIZES="200 ⭐|100 ⭐|50 ⭐"
# Доп. чаты для объявлений (основной чат выбирается командой /setchat)
TOURNAMENT_CHATS=

# Какая игра: baccarat или penalty
GAME=baccarat
# Пенальти: закрыть ставки на серию через столько секунд после конца предыдущей
PENALTY_START_DELAY=180
PENALTY_CLOSE_ON_PREV_FINISH=0
# Язык игроков по умолчанию: ru или uz (меняется в /admin)
BOT_LANG=ru

# Магазин (цены в фишках)
SHOP_BADGE_PRICE=1000
SHOP_TITLE_PRICE=10000
SHOP_CUSTOM_TITLE_PRICE=15000
SHOP_VIP_PRICE=5000
SHOP_SPIN_PRICE=100
